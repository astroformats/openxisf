@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Only a static library needs its private dependencies at link time.
if(NOT @OPENXISF_SHARED@)
    find_dependency(pugixml CONFIG)
    # CMake's module, which defines ZLIB::ZLIB, also for a consumer that prefers CMake packages: that of zlib 1.3.2
    # names the target of a static library ZLIB::ZLIBSTATIC.
    find_dependency(ZLIB MODULE)
    if(@OPENXISF_WITH_TBB@)
        find_dependency(TBB CONFIG)
    endif()
    if(@OPENXISF_WITH_OPENSSL@)
        find_dependency(OpenSSL)
    endif()

    # lz4 and zstd come with find modules, because many distributions ship only pkg-config files. They are found in a
    # file of their own: find_dependency() returns from the file that calls it when a package is missing, and the
    # modules must leave the module path of the caller first.
    set(openxisf_dependencies_found FALSE)
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/modules")
    include("${CMAKE_CURRENT_LIST_DIR}/openxisf-dependencies.cmake")
    list(POP_FRONT CMAKE_MODULE_PATH)
    if(NOT openxisf_dependencies_found)
        unset(openxisf_dependencies_found)
        return()
    endif()
    unset(openxisf_dependencies_found)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/openxisf-targets.cmake")

check_required_components(openxisf)
